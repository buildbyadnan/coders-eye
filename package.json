{
  "name": "coders-eye",
  "version": "0.1.2",
  "description": "Cross-repository AI code review for GitHub PRs — powered by Claude Code",
  "license": "MIT",
  "scripts": {
    "build:cli": "npx nx build cli",
    "build": "nx run-many -t build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npx vitest run",
    "typecheck": "nx run-many -t typecheck",
    "cli": "bash apps/cli/bin/coders-eye"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/devkit": "23.2.1",
    "@nx/js": "23.2.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "1.16.2",
    "@swc/helpers": "0.5.23",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "nx": "23.2.1",
    "prettier": "^3.9.8",
    "tslib": "^2.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
